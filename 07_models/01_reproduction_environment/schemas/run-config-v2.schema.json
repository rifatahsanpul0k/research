{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASTRA benchmark run configuration v2",
  "type": "object",
  "required": [
    "experiment_id", "dataset", "method", "compute_classification", "seed", "inputs",
    "preprocessing", "method_parameters", "clustering", "output_directory", "status"
  ],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP-"},
    "dataset": {"enum": ["LN_A1", "LN_D1", "MB_E11", "MB_E13", "MB_E15", "MB_E18"]},
    "method": {"type": "string", "minLength": 1},
    "compute_classification": {
      "enum": ["LOCAL_LIGHT", "COLAB_CPU", "COLAB_GPU", "COLAB_HIGH_MEMORY", "UNRESOLVED"]
    },
    "seed": {"type": "integer", "minimum": 0},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "modality", "matrix_path", "observation_ids", "feature_ids", "counts_or_processed"],
        "properties": {
          "dataset_id": {"enum": ["LN_A1", "LN_D1", "MB_E11", "MB_E13", "MB_E15", "MB_E18"]},
          "modality": {"type": "string"},
          "matrix_path": {"type": "string"},
          "observation_ids": {"type": "string"},
          "feature_ids": {"type": "string"},
          "counts_or_processed": {"type": "string"},
          "coordinates": {"type": ["string", "null"]},
          "labels": {"type": ["string", "null"]},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "preprocessing": {"type": "object"},
    "method_parameters": {"type": "object"},
    "clustering": {"type": "object"},
    "output_directory": {"type": "string"},
    "status": {"enum": ["PLANNED", "PREPARING", "RUNNING", "SUCCEEDED", "FAILED", "INVALID", "BLOCKED"]},
    "example_only": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["RUNNING", "SUCCEEDED"]}}},
      "then": {"properties": {"compute_classification": {"not": {"const": "UNRESOLVED"}}}}
    }
  ],
  "additionalProperties": false
}
